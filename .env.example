PORT=3000
SECRET_KEY=change-this-secret-key

# Postgres connection — either set DATABASE_URL, or leave it unset and use
# the discrete PG* vars below.
# DATABASE_URL=postgres://user:password@localhost:5432/rxsystem
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-this-password
PGDATABASE=rxsystem

# Node cluster mode: fixed worker count, not auto-scaling. Rule of thumb:
# workers <= (server CPU cores - 1), and stay conservative if this server
# also runs Postgres and/or other apps.
WEB_CONCURRENCY=2
